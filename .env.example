# Copy to .env and fill in locally. Never commit real credentials.
ANTHROPIC_API_KEY=
# Optional Bearer credential; API key takes precedence.
# ANTHROPIC_AUTH_TOKEN=
# Supply an Anthropic Messages-compatible endpoint and its model ID.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=your-model-id
ANTHROPIC_MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=180
